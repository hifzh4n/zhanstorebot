# Runtime
NODE_ENV=development

# Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_WEBHOOK_SECRET=your_webhook_secret

# Firebase
APP_PROJECT_ID=your_firebase_project_id
APP_STORAGE_BUCKET=your_firebase_project_id.firebasestorage.app
DUITNOW_QR_STORAGE_PATH=images/qr.JPG

# Admin
ADMIN_TELEGRAM_USERNAME=@your_admin_username
ADMIN_TELEGRAM_CHAT_ID=your_admin_chat_id
ADMIN_PANEL_URL=https://zhanstorebot.web.app

# SMS provider
SMS_PROVIDER=mock
SMSCODE_API_TOKEN=your_smscode_api_token
SMSCODE_BASE_URL=https://api.smscode.gg/v1
MOCK_PHONE_NUMBER=+60123456789
MOCK_OTP=123456

# OTP behavior
OTP_COOLDOWN_SECONDS=15
OTP_MAX_ATTEMPTS=10
AUTO_COMPLETE_MINUTES=10

# Production SMS provider, only needed when SMS_PROVIDER=smscode
# Set product SMSCode catalog IDs from the admin product form.
